{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Milkrice",
  "version": "0.1.0-rc1",
  "identifier": "com.yasithfernando.milkrice",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": {
      "script": "cargo build --release -p milkrice-core --bin milkrice-cli",
      "cwd": ".."
    }
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Milkrice",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        },
        "backgroundColor": "#F3EFE6"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/Library/Application Support/Milkrice/audio/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Local-first AI meeting notes",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "14.2",
      "entitlements": "Entitlements.plist",
      "files": {
        "MacOS/milkrice-cli": "../target/release/milkrice-cli"
      }
    },
    "resources": {
      "../skill/milkrice/SKILL.md": "skill/milkrice/SKILL.md"
    },
    "copyright": "Copyright © 2026 Yasith Fernando. MIT License.",
    "homepage": "https://milkrice.yasithfernando.com",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCMDY3NkQ1QTJGMDNGNDIKUldSQ1AvQ2kxWFlHMjJCaGF1VEVKQThDTDBuSm1RMCtRYW1SYklwV0NNcy9pc2Zlb2NOVVBpR3gK",
      "endpoints": [
        "https://github.com/thekindofme/milkrice/releases/latest/download/latest.json"
      ]
    }
  }
}
